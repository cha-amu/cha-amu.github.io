# Public frontend config only. Do not put secrets here.
VITE_API_URL=https://cha-amu-gateway.cha-amu.workers.dev/api
# VITE_GATEWAY_URL is supported as a temporary alias for VITE_API_URL.
VITE_STORAGE_BASE_URL=https://cha-amu.github.io/storage
VITE_ARCHIVE_MANIFEST_URL=https://cha-amu.github.io/storage/manifests/assets.json
VITE_STORAGE_POSTS_MANIFEST_URL=https://cha-amu.github.io/storage/manifests/posts.json
# The /wiki/ reading screen belongs to this blog. These URLs only serve public data and the map widget.
VITE_WIKI_EMBED_URL=https://cha-amu.github.io/amuwiki/
VITE_WIKI_INDEX_URL=https://cha-amu.github.io/amuwiki/wiki.json
VITE_TURNSTILE_SITE_KEY=0x4AAAAAADzr-jSxSMZf9xcv
# The admin session expires after 10 minutes without activity.
VITE_ADMIN_IDLE_TIMEOUT_MS=600000

# Inputs for the backup-only Apps Script scripts. Real values only in local .env.
# The site admin password is set with npm run admin:password, which asks for it and ignores ADMIN_PASSWORD here.
# Never expose these with a VITE_ prefix.
SPREADSHEET_ID=<SPREADSHEET_ID>
ADMIN_PASSWORD=
GUESTBOOK_PASSWORD_ITERATIONS=1
ADMIN_SESSION_TTL_MS=600000
GATEWAY_SHARED_SECRET=

# Worker secrets belong in `worker/.dev.vars`, not in VITE_ variables.
